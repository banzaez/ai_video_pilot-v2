# Конфигурация AI Video Pilot
# Приоритет: CLI-аргументы > этот YAML > значения по умолчанию в коде
#
# Пайплайн:
#   info → detect → tracklets → tracklet_reid → tracklet_link → track → pose → feet
#
# Склейка кусков ByteTrack — стадия tracklet_link (tracklet_pipeline.link → tracklet_links.json).
# Вкладка «Склейки» читает эти группы, отдельной стадии link нет.

pipeline:
  # all / no_merge = detect→feet (no_merge — алиас all)
  stage: "all"

video:
  # Папка prod-роликов (sessions) или один файл / session:01_20260601
  # Dev-lite только вручную: data/video/lite/foo.mp4
  input_path: "data/video"
  # Корень артефактов: data/results/{session_key}/ или data/results/{stem}/ (legacy)
  json_output_dir: "data/results"
  # Число процессов детекции. На MPS принудительно 1 (одна GPU)
  workers: 1

# Папка с весами Stage 1 (detect). Имена в detection.models — относительно неё.
models_dir: data/models/detect
# Папка с весами ReID (SOLIDER) — общая для tracklet_reid
reid_models_dir: data/models/reid

reid:
  device: mps
  batch_size: 8
  solider_weights: solider_swin_base_msmt17.pth
  solider_semantic_weight: 0.2
  solider_image_size: [384, 128]
  solider_transformer: swin_base_patch4_window7_224

# --- Stage 1: detect → detections.json ---
detection:
  # yolo | rtdetr | rtdetr_v2
  # rtdetr: Ultralytics RT-DETR v1 (rtdetr-l.pt / rtdetr-x.pt)
  # rtdetr_v2: Hugging Face RT-DETRv2 (PekingU/rtdetr_v2_*), pip install transformers
  backend: rtdetr_v2
  # Порог уверенности детекции (0..1). Ниже — больше боксов, выше — чище, но можно пропустить людей
  conf: 0.35
  # NMS IoU. Дефолт YOLO 0.7 пропускает торс+полный рост (как #9/#10). 0.5 оставляет больший бокс
  iou: 0.5
  # Каждый N-й кадр (1 = все). Трекер получает только эти наблюдения; fps видео ему не нужен.
  detect_every_n: 3
  # Устройство инференса: mps | cuda | cpu | auto
  device: "auto"

  # Классы COCO для фильтрации: 0 = person
  classes: [0]
  # Точность инференса: 16/fp16 = FP16, null/32 = FP32 (на CPU всегда FP32)
  quantize: 16
  # Кадров за predict на Stage 1. RT-DETR обычно 16, YOLO можно 32+
  batch_size: 16
  # Размер входа (px по длинной стороне)
  imgsz: 960
  # Веса по backend. yolo/rtdetr — файлы в models_dir; rtdetr_v2 — HF id или локальная папка
  models:
    yolo: yolo26s_person_ft_v2.pt
    rtdetr: rtdetr-l.pt
    rtdetr_v2: PekingU/rtdetr_v2_r50vd

# --- Stage 2a–2c: tracklets → ReID → tracklet_link ---
tracklet_pipeline:
  min_obs: 2
  min_sec: 0
  # ByteTrack для коротких треклетов (Stage 2a → tracklet_frames.json)
  tracker:
    type: bytetrack
    track_high_thresh: 0.25
    track_low_thresh: 0.1
    new_track_thresh: 0.55
    track_buffer: 11
    match_thresh: 0.78
    fuse_score: false
  # Stage 2b: эмбеддинги кропов треклетов (tracklet_reid.json + .npz)
  reid:
    top_k: 10
    pick: spread
    batch_size: 8
    # JPG на диск не нужны для 2c (эмбеддинги в npz). true — только для отладки
    save_crops: false
    crops_dir: tracklet_crops
  # Stage 2c tracklet_link → tracklet_links.json (вкладка «Склейки»)
  # Два прохода: Pass 1 — цепочки по combo в окнах; Pass 2 — досклейка готовых цепочек по ReID.
  link:
    # --- кандидаты A→B (кто вообще может стать соседом) ---
    # Макс. пауза между концом A и началом B, сек. Дальше ребро не строится.
    max_gap_sec: 6.0
    # Мин. ReID (max pairwise по кропам). Ниже — пара отбрасывается ещё до combo.
    min_reid_score: 0.95
    # Макс. «промах» предсказанной точки: куда A должен был дойти к t0(B) vs p0(B), px.
    # 0 = не фильтровать по motion на этапе кандидатов.
    max_spatial_px: 700
    max_spatial_m: 4.0
    # Ширина гаусса для motion-score: exp(-residual / sigma). Больше = мягче к скачку bbox.
    motion_sigma_px: 250
    motion_sigma_m: 1.5
    # Насколько похож должны быть росты bbox (log-шкала). Меньше = строже к смене масштаба.
    size_log_scale: 0.45
    # Веса combo = w_reid·reid + w_motion·motion + w_size·size + w_gap·gap (сумма ≈ 1).
    w_reid: 0.55
    w_motion: 0.25
    w_size: 0.10
    w_gap: 0.10

    # --- Pass 1: цепочки во времени ---
    # Мин. combo, чтобы ребро участвовало в склейке окна. Выше = меньше ложных, больше разрывов.
    auto_min_score: 0.60
    # Длина временного окна, сек. Длинные видео режутся на окна; внутри — Hungarian/greedy.
    window_sec: 120
    # Перекрытие соседних окон, сек (чтобы цепочки на стыке не обрывались).
    window_overlap_sec: 15
    # hungarian — глобальный 1-1 assignment в окне; greedy — жадный fallback.
    solver: hungarian

    # Высота плоскости пересечения луча, м (0 = пол; совпадает с калибровкой пар)
    torso_height_m: 0.0
    # Перед склейкой: YOLO-pose только на f0/f1 каждого треклета → ноги в map_p0/map_p1.
    # Полные стадии pose/feet после track по-прежнему для карты.

# --- Stage track: ремап треклетов → tracking.json / tracks.json ---
tracker_filters:
  # Мин. площадь bbox (медиана по треку, px²). ~50×50=2500 — отсекает «точки»
  min_bbox_area: 2500
  # Выкинуть трек, если обе стороны bbox (медиана W и H) < этого, px
  min_bbox_side: 40
  # Мин. длина трека в секундах (последний−первый кадр). Короче — выкинуть
  min_track_sec: 0

# --- Stage pose: YOLO-pose → poses.json ---
pose:
  model: yolo26s-pose.pt
  conf: 0.25
  kpt_min: 0.25
  every_n: 4

# --- Stage feet: проекция ног → feet.json ---
feet:
  torso_height_m: 0.0
  person_height_m: 1.70
  smooth_window: 5
  max_speed_mps: 2.0

# --- Stage camera_link (Pass 10): верхнеуровневая склейка по InsightFace и координатам ног ---
camera_link:
  enabled: true
  face_model: buffalo_l
  face_top_k: 5
  face_max_attempts: 15
  min_face_score: 0.60
  save_face_crops: true
  face_crops_dir: face_crops
  max_gap_sec: 120.0
  max_speed_mps: 3.5
  motion_sigma_m: 2.0
  w_face: 0.50
  w_reid: 0.30
  w_motion: 0.20
  solver: hungarian

nvr:
  enabled: true
  host: "183.88.220.86"
  port: 8003
  track_ids:
    - "1501"
    - "1401"
  track_camera_map: { "1401": "Camera_01", "1501": "Camera_02" }
  search_lookback_hours: 24
  connect_timeout_sec: 30
  read_timeout_search_sec: 120
  read_timeout_download_sec: 900
